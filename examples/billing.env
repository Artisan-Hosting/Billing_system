# Example Billing secrets file -- copy to /opt/artisan/etc/billing.env,
# fill in real values, and `chmod 0600` it. Never commit a filled-in copy.
#
# Process environment variables of the same name take precedence over this
# file, so this can also just be a reference for what to export in CI.

DATABASE_URL=mysql://billing:password@127.0.0.1:3306/billing
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
