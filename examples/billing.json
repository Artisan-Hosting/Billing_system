// Example Billing config -- copy to /opt/artisan/etc/billing.json and edit.
// Comments and missing fields are both fine: unset fields fall back to the
// defaults in src/config.rs, and a missing file is not an error at all.
{
  "grpc": {
    // Address the gRPC server binds to.
    "bind": "0.0.0.0:50061",
    // Serves reflection so `grpcurl -plaintext <addr> list` works.
    "reflection": true
  },
  "http": {
    // Address the usage-cost HTTP server (`POST /calculate`) binds to.
    "bind": "0.0.0.0:3031"
  },
  "auth": {
    // ais_auth's AccountInternal gRPC address. Use an `https://` mTLS
    // address in production; plaintext `http://` is local-dev only.
    "grpc_addr": "http://127.0.0.1:50051",
    "token_cache_secs": 60
  },
  "purchasing": {
    // Kill switch for the two money-moving RPCs (CreateOrUpgradeSubscription,
    // TopUpCredit). Leave this false until purchasing is ready to go live.
    "enabled": false
  }
}
